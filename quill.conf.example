# Quill motion configuration. Copy to quill.conf or pass --config path.
# Neovide-style defaults: spring scroll/cursor, cursor trail, smooth blink.
style = ease              # ease | linear | instant (instant snaps)
scroll_ms = 300           # scroll spring settling time
scroll_far_lines = 1      # jumps farther than this snap all but the last line
cursor_ms = 150           # cursor spring settling time
trail_size = 1.0          # 0 disables cursor trail, 1 is full trail
blink_ms = 530            # half-period; 0 disables blinking
smooth_blink = true       # cosine fade instead of hard on/off
animate_insert = true     # animate cursor while in Insert mode
indent_guides = true      # faint rules at each indent stop
picker_ms = 120
reduced_motion = false    # true disables scroll/cursor/blink animation

# Dramatic camera: instead of scrolling the minimum distance to keep the cursor
# on screen, park it at a fixed lead point of the viewport and let the springs
# carry the page there. One switch, no effect when off.
dramatic = false          # true | false (opt-in)
dramatic_lead_x = 0.30    # cursor x as a fraction of the text area (0..0.5)
dramatic_lead_y = 0.33    # cursor y as a fraction of the viewport (0..0.5)
dramatic_ms = 180         # camera spring settling time (0 snaps)

# Cursor VFX (Neovide port + Quill extras). Empty/none disables.
# Multiple modes may be combined with commas, e.g. railgun,ripple.
cursor_vfx_mode = none            # railgun torpedo pixiedust sonicboom ripple wireframe comet ember aurora glitch pulse snow confetti spark smoke shockwave halo
cursor_vfx_opacity = 200          # 0..255
cursor_vfx_particle_lifetime = 0.5
cursor_vfx_particle_highlight_lifetime = 0.2
cursor_vfx_particle_density = 0.7 # particles per cell of travel
cursor_vfx_particle_speed = 10.0
cursor_vfx_particle_phase = 1.5   # railgun only
cursor_vfx_particle_curl = 1.0    # railgun/torpedo/pixiedust curl

# Appearance (both optional; defaults add no overhead).
# Background image drawn behind the editor. Empty/none disables it.
# PNG / JPEG / BMP / TGA are supported.
background_image = ~/hm.jpg           # e.g. /path/to/wallpaper.png
background_fit = cover            # cover | contain | stretch
# Editor opacity fades only the chrome (background, gutter, highlights,
# selections, status bar, picker). Text, cursor and VFX stay fully opaque.
# 1.0 is fully opaque (the default, zero-cost path); lower it to reveal the
# background image, e.g. 0.85.
editor_opacity = 1.0              # 0.0 .. 1.0
# Darken the wallpaper so text stays readable on busy photos. 0 leaves the
# image untouched; 1 is black. The vignette darkens the edges on top of that.
background_dim = 0.0              # 0.0 .. 1.0
background_vignette = 0.0         # 0.0 .. 1.0

# Whole-window opacity: 1 is an opaque window (the default). Below 1 blends
# the editor with the desktop (needs compositor alpha support; Wayland has
# it). Independent of editor_opacity, which only fades the chrome.
window_opacity = 1.0              # 0.2 .. 1.0

# Theme: a palette file that replaces the built-in Noir. See docs/THEMES.md
# for the complete catalog. Empty/none/default keeps the built-in palette.
# Applied once at load time.
theme = none                      # e.g. themes/naysayer.theme

# Session restore: reopen the last buffers with their cursor and scroll
# positions when launched with no file arguments. Saved on exit.
session_restore = true
session_file = ~/.config/quill/session
